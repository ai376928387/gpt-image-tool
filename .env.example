# YAI Router API key. Keep this file as a template; put the real key in .env.
XAI_API_KEY=
BASE_URL=https://api.yairouter.com/v1
CLIENT_PORT=5173
GATEWAY_PORT=3001
TEXT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_OUTPUT_FORMAT=png
MAX_REFERENCE_IMAGES=8
IMAGE_OUTPUT_DIR=.image-output
# Optional override when the MCP adapter should call a different local gateway.
# MCP_GATEWAY_URL=http://127.0.0.1:3001
